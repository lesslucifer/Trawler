# Rust build artifacts
/target
**/*.rs.bk
*.pdb

# Generated Certificate Authority — NEVER commit the private key
/ca/

# Archived docs stay out of git (their content history remains in git)
/docs/.archive/

# Local manual-review trust store — provisioned by `cargo xtask mr setup`,
# never committed (DEC-10): signature verification is a local-machine concern
/.mr-allowed

# Environment / editor
.env
.env.local
.DS_Store
.idea/
.vscode/
*.swp
