{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the Trawler desktop app",
  "windows": ["main", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-save",
    "fs:allow-write-file",
    "dialog:allow-open",
    "fs:allow-read-file"
  ]
}
