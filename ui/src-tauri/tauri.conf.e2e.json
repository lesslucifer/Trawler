{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Trawler",
        "create": false,
        "width": 1440,
        "height": 800,
        "minWidth": 850,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "capabilities": [
        "default",
        "data-window",
        "about",
        {
          "identifier": "wdio",
          "windows": [
            "main",
            "settings",
            "about",
            "data-*"
          ],
          "permissions": [
            "wdio:default",
            "core:window:allow-set-size",
            "core:window:allow-set-position",
            "core:window:allow-close"
          ]
        }
      ]
    }
  }
}
