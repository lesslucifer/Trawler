{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "wdio",
          "windows": ["main"],
          "permissions": ["wdio:default"]
        }
      ]
    }
  }
}
