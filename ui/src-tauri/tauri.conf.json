{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trawler",
  "identifier": "dev.trawler.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Trawler",
        "create": false,
        "width": 1440,
        "height": 800,
        "minWidth": 850,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0NDJGMTQ4RDE3RERCMDcKUldRSDIzM1JTUEZDZEZ5L1VHYTRtV0dybmgxWWFQUlJQZThGazVUc3M2MTIxVmNSVnA1NFM0THQK",
      "endpoints": [
        "https://github.com/lesslucifer/Trawler/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Native MITM HTTP(S) debugging proxy.",
    "longDescription": "Trawler is a native HTTP(S) debugging proxy: it captures the traffic of the apps and devices pointed at it, decrypts HTTPS with its own local certificate authority, and lets you inspect, filter, replay and export every request and response. Everything stays on your machine.",
    "publisher": "Vu Luu",
    "copyright": "Copyright \u00a9 2026 Vu Luu",
    "license": "MIT",
    "homepage": "https://github.com/lesslucifer/Trawler",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "linux": {
      "deb": {
        "section": "devel"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "files": {
        "Library/LaunchAgents/dev.trawler.app.plist": "launch-agent/dev.trawler.app.plist"
      }
    }
  }
}
