#!/bin/sh
# Fast local mirror of the CI commit gate.
set -e
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# main is merge-only: every change lands through a gated --no-ff merge.
# Merge completions carry MERGE_HEAD and are gated below / by pre-merge-commit.
if [ "$(git symbolic-ref --short -q HEAD || true)" = "main" ] \
  && [ ! -f "$(git rev-parse --git-path MERGE_HEAD)" ]; then
  cat >&2 <<'EOF'
[pre-commit] REFUSED: direct commits on main are not allowed (docs/workflow.html)
Start the work on a branch and land it through the merge gate:
  epic:         git checkout -b epic/<slug> main
  working unit: git checkout -b wu/<epic-slug>/<slug> epic/<slug>
This applies to ALL changes, docs included - the merge gate exempts
docs/infra-only diffs automatically, so branch + --no-ff merge is the
whole ceremony.
EOF
  exit 1
fi

# fmt + clippy, skipped when this exact tree content already passed them - the
# pair used to run blind on every commit, so a WU paid for clippy once per
# commit instead of once per change (DEC-54). The --workspace scoping lives in
# xtask::gate0::CLIPPY, pinned by its own test.
echo "[pre-commit] cargo xtask lint"
cargo xtask lint

# Conflicted merges never reach pre-merge-commit; their completion lands here
# with MERGE_HEAD on disk - gate it the same way.
if [ -f "$(git rev-parse --git-path MERGE_HEAD)" ]; then
  branch=$(git symbolic-ref --short -q HEAD || true)
  case "$branch" in
  main)
    echo "[pre-commit] merge completion - cargo xtask verify-dod hook epic"
    cargo xtask verify-dod hook epic
    echo "[pre-commit] merge completion - cargo xtask gate0 merge - the merged tree"
    exec cargo xtask gate0 merge
    ;;
  epic/*)
    echo "[pre-commit] merge completion - cargo xtask verify-dod hook wu"
    exec cargo xtask verify-dod hook wu
    ;;
  esac
fi
