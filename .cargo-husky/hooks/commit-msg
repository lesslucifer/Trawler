#!/bin/sh
# Manual-review gate at commit time: if the staged diff touches rule-bearing
# docs (T0 CLAUDE.md / T1 flat docs/), the message must carry a Reviewed-By
# trailer naming an identity in .mr-allowed.
set -e
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

exec cargo xtask verify-dod commit-msg "$1"
